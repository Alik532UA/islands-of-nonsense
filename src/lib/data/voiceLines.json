			"text": "Мороз і кігті!",
			"voice": "uk-UA-OstapNeural",
			"pitch": "-24Hz",
			"rate": "-2%"
		},
		"n014": {
			"text": "Зима заморозить ваші серця.",
			"voice": "uk-UA-PolinaNeural",
			"pitch": "-6Hz",
			"rate": "-4%"
		},
		"n015": {
			"text": "Духи підкажуть правильне закляття!",
			"voice": "uk-UA-OstapNeural",
			"pitch": "-6Hz",
			"rate": "+8%"
		},
		"n011": {
			"text": "Північ стоїть непорушно!",
			"voice": "uk-UA-OstapNeural",
			"pitch": "-18Hz",
			"rate": "+0%"
		},
		"n010": {
			"text": "Крижане дихання скує ворога!",
			"voice": "uk-UA-OstapNeural",
			"pitch": "-22Hz",
			"rate": "-4%"
		},
		"h04I": {
			"text": "Блискавка вдарить миттєво!",
			"voice": "uk-UA-OstapNeural",
			"pitch": "-10Hz",
			"rate": "+6%"
		},
		"n01G": {
			"text": "Магма палає в мені!",
			"voice": "uk-UA-OstapNeural",
			"pitch": "-22Hz",
			"rate": "+4%"
		},
		"n01F": {
			"text": "Грані кристалу ріжуть як лезо!",
			"voice": "uk-UA-OstapNeural",
			"pitch": "-20Hz",
			"rate": "-6%"
		},
		"n01D": {
			"text": "Небо спалахне вогнем!",
			"voice": "uk-UA-OstapNeural",
			"pitch": "-24Hz",
			"rate": "+0%"
		},
		"n019": {
			"text": "Хвиля змиє перешкоди.",
			"voice": "uk-UA-OstapNeural",
			"pitch": "-14Hz",
			"rate": "-6%"
		},
		"e007": {
			"text": "Сила лісу з нами.",
			"voice": "uk-UA-OstapNeural",
			"pitch": "-8Hz",
			"rate": "-4%"
		},
		"n01Z": {
			"text": "Швидко і без сліду.",
			"voice": "uk-UA-OstapNeural",
			"pitch": "+2Hz",
			"rate": "+10%"
		},
		"e00B": {
			"text": "Тінь помсти вже поруч.",
			"voice": "uk-UA-PolinaNeural",
			"pitch": "-10Hz",
			"rate": "+0%"
		},
		"e002": {
			"text": "Зорі падають на ворогів!",
			"voice": "uk-UA-PolinaNeural",
			"pitch": "+6Hz",
			"rate": "+4%"
		},
		"e001": {
			"text": "Місяць освітить здобич!",
			"voice": "uk-UA-PolinaNeural",
			"pitch": "+0Hz",
			"rate": "+6%"
		},
		"e000": {
			"text": "Іскри магії танцюють!",
			"voice": "uk-UA-PolinaNeural",
			"pitch": "+14Hz",
			"rate": "+12%"
		},
		"z002": {
			"text": "Хто замовляв вогнику?",
			"voice": "uk-UA-OstapNeural",
			"pitch": "-4Hz",
			"rate": "+10%"
		},
		"n01T": {
			"text": "Шторм підкоряється моїй волі!",
			"voice": "uk-UA-PolinaNeural",
			"pitch": "-8Hz",
			"rate": "+0%"
		},
		"n01V": {
			"text": "Ха-ха! Зараз усе вибухне!",
			"voice": "uk-UA-OstapNeural",
			"pitch": "+16Hz",
			"rate": "+16%"
		},
		"h06Q": {
			"text": "Тримаю курс! Бомби готові!",
			"voice": "uk-UA-OstapNeural",
			"pitch": "+12Hz",
			"rate": "+14%"
		},
		"n01X": {
			"text": "Сталь не відчуває болю.",
			"voice": "uk-UA-OstapNeural",
			"pitch": "-30Hz",
			"rate": "-10%"
		},
		"h06T": {
			"text": "Швидкий рейд! Поїхали!",
			"voice": "uk-UA-OstapNeural",
			"pitch": "+4Hz",
			"rate": "+10%"
		},
		"cg11": {
			"text": "Брухт теж піде в діло!",
			"voice": "uk-UA-OstapNeural",
			"pitch": "+8Hz",
			"rate": "+12%"
		},
		"cg12": {
			"text": "Щити підняті! Прориваємось!",
			"voice": "uk-UA-OstapNeural",
			"pitch": "-16Hz",
			"rate": "+2%"
		},
		"cg14": {
			"text": "Потрошимо ворожу броню!",
			"voice": "uk-UA-OstapNeural",
			"pitch": "-20Hz",
			"rate": "+6%"
		},
		"cg16": {
			"text": "Ціль захоплена! Коригую вогонь!",
			"voice": "uk-UA-OstapNeural",
			"pitch": "+4Hz",
			"rate": "+10%"
		},
		"cg18": {
			"text": "Камінь летить прямо в замок!",
			"voice": "uk-UA-OstapNeural",
			"pitch": "-14Hz",
			"rate": "+2%"
		},
		"cg19": {
			"text": "Вітер під крилами! Пікірую!",
			"voice": "uk-UA-OstapNeural",
			"pitch": "+10Hz",
			"rate": "+12%"
		},
		"hfoo": {
			"text": "За короля! Тримати стрій!",
			"voice": "uk-UA-OstapNeural",
			"pitch": "-4Hz",
			"rate": "+6%"
		},
		"n003": {
			"text": "Мргл-мргл! Вперед!",
			"voice": "uk-UA-OstapNeural",
			"pitch": "+12Hz",
			"rate": "+14%"
		},
		"n00A": {
			"text": "Почуй гарчання пекла!",
			"voice": "uk-UA-OstapNeural",
			"pitch": "-26Hz",
			"rate": "+6%"
		},
		"n00B": {
			"text": "Кістки бряжчать на війну.",
			"voice": "uk-UA-OstapNeural",
			"pitch": "-20Hz",
			"rate": "-4%"
		},
		"o002": {
			"text": "Лок-тар! Сила і лють!",
			"voice": "uk-UA-OstapNeural",
			"pitch": "-24Hz",
			"rate": "+2%"
		},
		"n017": {
			"text": "Холодний слід веде до здобичі.",
			"voice": "uk-UA-OstapNeural",
			"pitch": "-16Hz",
			"rate": "+4%"
		},
		"n01I": {
			"text": "Древній лук не знає промаху.",
			"voice": "uk-UA-OstapNeural",
			"pitch": "-10Hz",
			"rate": "-2%"
		},
		"n00B_u2": {
			"text": "Вічна варта не знає спокою.",
			"voice": "uk-UA-OstapNeural",
			"pitch": "-24Hz",
			"rate": "-6%"
		},
		"u001_u2": {
			"text": "Стогін потойбіччя скує вас!",
			"voice": "uk-UA-PolinaNeural",
			"pitch": "-14Hz",
			"rate": "-6%"
		},
		"n00E_u2": {
			"text": "Кістяна фортеця крокує вперед!",
			"voice": "uk-UA-OstapNeural",
			"pitch": "-34Hz",
			"rate": "-10%"
		},
		"u000_u2": {
			"text": "Крилаті пазурі вже над вами!",
			"voice": "uk-UA-OstapNeural",
			"pitch": "-18Hz",
			"rate": "+10%"
		},
		"o002_u2": {
			"text": "Могутній удар змете ворогів!",
			"voice": "uk-UA-OstapNeural",
			"pitch": "-28Hz",
			"rate": "+2%"
		},
		"o003_u2": {
			"text": "Магічний спис пробиває броню!",
			"voice": "uk-UA-OstapNeural",
			"pitch": "-12Hz",
			"rate": "+8%"
		},
		"o009_u2": {
			"text": "Небо належить еліті Орди!",
			"voice": "uk-UA-OstapNeural",
			"pitch": "-16Hz",
			"rate": "+6%"
		},
		"o001_u2": {
			"text": "Бойова віверна розриває стрій!",
			"voice": "uk-UA-OstapNeural",
			"pitch": "-20Hz",
			"rate": "+4%"
		},
		"n00A_u2": {
			"text": "Лютий звір зірвався з ланцюга!",
			"voice": "uk-UA-OstapNeural",
			"pitch": "-30Hz",
			"rate": "+6%"
		},
		"n008_u2": {
			"text": "Усі схиляться перед королевою ночі.",
			"voice": "uk-UA-PolinaNeural",
			"pitch": "-8Hz",
			"rate": "-4%"
		},
		"n00L_u2": {
			"text": "Князь крові вимагає жертв!",
			"voice": "uk-UA-OstapNeural",
			"pitch": "-32Hz",
			"rate": "-2%"
		},
		"n001_u2": {
			"text": "Древнє полум'я спалить світ!",
			"voice": "uk-UA-OstapNeural",
			"pitch": "-34Hz",
			"rate": "-8%"
		},
		"n000_u2": {
			"text": "Вищий інфернал не знає пощади!",
			"voice": "uk-UA-OstapNeural",
			"pitch": "-35Hz",
			"rate": "-10%"
		},
		"n01V_u2": {
			"text": "Більше пороху! Більше вибухів!",
			"voice": "uk-UA-OstapNeural",
			"pitch": "+16Hz",
			"rate": "+18%"
		},
		"n01T_u2": {
			"text": "Гнів морських глибин прокинувся!",
			"voice": "uk-UA-PolinaNeural",
			"pitch": "-12Hz",
			"rate": "-2%"
		},
		"n017_u2": {
			"text": "Ікла криги роздеруть ворога!",
			"voice": "uk-UA-OstapNeural",
			"pitch": "-22Hz",
			"rate": "+6%"
		},
		"n011_u2": {
			"text": "Ветеран півночі не відступає!",
			"voice": "uk-UA-OstapNeural",
			"pitch": "-22Hz",
			"rate": "+0%"
		},
		"n010_u2": {
			"text": "Віковічний лід скує арену!",
			"voice": "uk-UA-OstapNeural",
			"pitch": "-28Hz",
			"rate": "-6%"
		},
		"n014_u2": {
			"text": "Вклоніться імператриці вічної зими!",
			"voice": "uk-UA-PolinaNeural",
			"pitch": "-10Hz",
			"rate": "-6%"
		},
		"h00U_u2": {
			"text": "Королівські крила несуть бурю!",
			"voice": "uk-UA-OstapNeural",
			"pitch": "-10Hz",
			"rate": "+4%"
		},
		"n01Y_u2": {
			"text": "Елітний мисливець не знає пощади!",
			"voice": "uk-UA-OstapNeural",
			"pitch": "+2Hz",
			"rate": "+8%"
		},
		"e005_u2": {
			"text": "Кожен постріл — смертельний!",
			"voice": "uk-UA-PolinaNeural",
			"pitch": "+0Hz",
			"rate": "+4%"
		},
		"e002_u2": {
			"text": "Зоряний гнів впаде з небес!",
			"voice": "uk-UA-PolinaNeural",
			"pitch": "+2Hz",
			"rate": "+2%"
		},
		"e000_u2": {
			"text": "Сяйво магії засліпить ворогів!",
			"voice": "uk-UA-PolinaNeural",
			"pitch": "+12Hz",
			"rate": "+10%"
		},
		"n01I_u2": {
			"text": "Ліс приховує мою стрілу.",
			"voice": "uk-UA-OstapNeural",
			"pitch": "-12Hz",
			"rate": "+2%"
		},
		"n01G_u2": {
			"text": "Вогонь і кігті розплавлять усе!",
			"voice": "uk-UA-OstapNeural",
			"pitch": "-26Hz",
			"rate": "+4%"
		},
		"h04I_u2": {
			"text": "Буря підкоряється лише мені!",
			"voice": "uk-UA-OstapNeural",
			"pitch": "-18Hz",
			"rate": "+0%"
		},
		"n003_u2": {
			"text": "Гвардія глибин тримає рубіж!",
			"voice": "uk-UA-OstapNeural",
			"pitch": "+6Hz",
			"rate": "+10%"
		},
		"n00H_u2": {
			"text": "Стародавній змій несе загибель!",
			"voice": "uk-UA-OstapNeural",
			"pitch": "-24Hz",
			"rate": "-4%"
		},
		"n007_u2": {
			"text": "Непробивний панцир йде в наступ!",
			"voice": "uk-UA-OstapNeural",
			"pitch": "-28Hz",
			"rate": "-8%"
		},
		"n00S_u2": {
			"text": "Пісня безодні забере ваші сили.",
			"voice": "uk-UA-PolinaNeural",
			"pitch": "-4Hz",
			"rate": "-4%"
		},
		"hfoo_u2": {
			"text": "Загартовані в боях! Вперед!",
			"voice": "uk-UA-OstapNeural",
			"pitch": "-10Hz",
			"rate": "+4%"
		},
		"hmtm_u2": {
			"text": "Важкий калібр! Земля тремтить!",
			"voice": "uk-UA-OstapNeural",
			"pitch": "-18Hz",
			"rate": "+2%"
		},
		"h016_u2": {
			"text": "Вища майстерність стрільби!",
			"voice": "uk-UA-OstapNeural",
			"pitch": "+2Hz",
			"rate": "+4%"
		},
		"n005_u2": {
			"text": "Верховна тьма поглине світ!",
			"voice": "uk-UA-OstapNeural",
			"pitch": "-30Hz",
			"rate": "-6%"
		}
	}
}
