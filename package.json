{
	"name": "islands-of-nonsense",
	"version": "0.0.159",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev --port 5174 --strictPort",
		"emulators": "npx --engine-strict=false firebase-tools emulators:start --config firebase.dev.json --project demo-islands-of-nonsense",
		"build": "vite build",
		"bump": "node scripts/bump-version.mjs",
		"preview": "vite preview",
		"prepare": "svelte-kit sync && husky || echo ''",
		"test": "vitest run",
		"test:unit": "vitest run",
		"test:e2e": "playwright test",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"check:i18n": "node scripts/check-i18n.mjs",
		"check:tests": "node scripts/check-test-discovery.mjs",
		"rules:stamp": "node scripts/rules-stamp.mjs",
		"rules:stamp:check": "node scripts/rules-stamp.mjs --check",
		"rooms:sweep": "node scripts/sweep-rooms.mjs",
		"check:rules": "node scripts/check-rules.mjs && node scripts/rules-stamp.mjs --check",
		"check:build": "npm run check:rules && node scripts/check-build.mjs",
		"check:bundle": "node scripts/check-bundle.mjs",
		"test:balance": "vitest run src/lib/engine/balanceRunner.test.ts",
		"verify": "node scripts/verify-ci.mjs",
		"check:ci": "node scripts/verify-ci.mjs",
		"audit:ci": "node scripts/check-audit.mjs",
		"lint": "npm run lint:format && npm run lint:code",
		"lint:format": "prettier --check .",
		"lint:code": "eslint .",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.65.1",
		"@sveltejs/adapter-auto": "^8.0.1",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^26.6.6",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"husky": "^9.1.7",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.2.0",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.73.0",
		"vite": "^8.3.8",
		"vitest": "^4.1.12"
	},
	"dependencies": {
		"firebase": "^13.4.0",
		"lucide-svelte": "^1.0.1",
		"pixi.js": "^8.23.0"
	},
	"overrides": {
		"@grpc/grpc-js": "^1.14.0"
	}
}
