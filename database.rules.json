{
	"rules": {
		"__rulesVersion": {
			"$v": {
				".read": "auth != null && $v === '62adf6869f54'"
			}
		},
		"rooms": {
			"$code": {
				".write": "auth != null && !newData.exists() && data.child('info/hostUid').val() === auth.uid",
				"info": {
					".read": "auth != null",
					".write": "auth != null && (data.exists() ? data.child('hostUid').val() === auth.uid && newData.exists() : (newData.child('hostUid').val() === auth.uid && $code.matches(/^[0-9A-Z]{2,6}$/)))",
					".validate": "newData.hasChildren(['gameId', 'rulesVersion', 'seed', 'status', 'hostUid'])",
					"status": {
						".validate": "newData.isString() && (newData.val() === 'lobby' || newData.val() === 'playing' || newData.val() === 'over')"
					},
					"gameId": {
						".validate": "newData.isString() && newData.val().length <= 32"
					},
					"hostUid": {
						".validate": "newData.isString() && newData.val().length <= 128"
					},
					"seed": {
						".validate": "newData.isNumber()"
					},
					"rulesVersion": {
						".validate": "newData.isNumber()"
					},
					"createdAt": {
						".validate": "newData.isNumber() && newData.val() <= now && newData.val() > now - 60000"
					},
					"startedAt": {
						".validate": "newData.isNumber() && newData.val() <= now && newData.val() > now - 60000"
					},
					"aliveAt": {
						".write": "auth != null && root.child('rooms').child($code).child('members').child(auth.uid).exists()",
						".validate": "newData.isNumber() && newData.val() <= now && newData.val() > now - 60000"
					},
					"autoStart": {
						".validate": "newData.isBoolean()"
					},
					"listed": {
						".validate": "newData.isBoolean()"
					},
					"countdownAt": {
						".validate": "newData.isNumber() && newData.val() <= now && newData.val() > now - 60000"
					},
					"config": {
						".validate": "newData.hasChildren(['modeId', 'teamSize', 'targetWins'])",
						"modeId": {
							".validate": "newData.isString() && newData.val().length <= 32"
						},
						"teamSize": {
							".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 3"
						},
						"targetWins": {
							".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 5"
						},
						"startGold": {
							".validate": "newData.isNumber() && newData.val() >= 100 && newData.val() <= 5000"
						},
						"allRandom": {
							".validate": "newData.isBoolean()"
						},
						"uniqueRaces": {
							".validate": "newData.isBoolean()"
						},
						"coinMode": {
							".validate": "newData.val() === 'none' || newData.val() === 'normal' || newData.val() === 'crazy'"
						},
						"isPrivate": {
							".validate": "newData.isBoolean()"
						},
						"botDifficulty": {
							".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 4"
						}
					},
					"roster": {
						".validate": "newData.hasChildren()",
						"$uid": {
							".validate": "newData.hasChildren(['name', 'seat'])",
							"name": {
								".validate": "newData.isString() && newData.val().length <= 48"
							},
							"seat": {
								".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5"
							},
							"team": {
								".validate": "newData.val() === 'west' || newData.val() === 'east'"
							},
							"race": {
								".validate": "newData.isString() && newData.val().length <= 32"
							},
							"$other": {
								".validate": false
							}
						}
					},
					"$other": {
						".validate": false
					}
				},
				"members": {
					".read": "auth != null",
					"$uid": {
						".write": "auth != null && (($uid === auth.uid && (!newData.exists() || (root.child('rooms').child($code).child('info').exists() && $code.matches(/^[0-9A-Z]{2,6}$/)))) || (!newData.exists() && root.child('rooms').child($code).child('info/hostUid').val() === auth.uid))",
						".validate": "newData.hasChildren(['name', 'role', 'order'])",
						"name": {
							".validate": "newData.isString() && newData.val().length <= 48"
						},
						"role": {
							".validate": "newData.val() === 'player' || newData.val() === 'spectator'"
						},
						"order": {
							".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 10"
						},
						"slot": {
							".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 6"
						},
						"country": {
							".validate": "newData.isString() && newData.val().length === 2"
						},
						"avatar": {
							".validate": "newData.isString() && newData.val().length <= 32"
						},
						"team": {
							".validate": "newData.val() === 'west' || newData.val() === 'east'"
						},
						"race": {
							".validate": "newData.isString() && newData.val().length <= 32"
						},
						"ready": {
							".validate": "newData.isBoolean()"
						},
						"compact": {
							".validate": "newData.isBoolean()"
						},
						"account": {
							".validate": "newData.isBoolean()"
						},
						"lastMoveAt": {
							".validate": "newData.isNumber() && newData.val() <= now && newData.val() > now - 60000 && (!data.exists() || newData.val() > data.val())"
						},
						"lastChatAt": {
							".validate": "newData.isNumber() && newData.val() <= now && newData.val() > now - 60000 && (!data.exists() || newData.val() > data.val())"
						},
						"$other": {
							".validate": false
						}
					}
				},
				"moves": {
					".read": "auth != null && root.child('rooms').child($code).child('members').child(auth.uid).exists()",
					"$seq": {
						".write": "auth != null && !data.exists() && newData.exists() && root.child('rooms').child($code).child('members').child(auth.uid).exists() && newData.child('by').val() === auth.uid && newData.parent().parent().child('members').child(auth.uid).child('lastMoveAt').val() === newData.child('at').val() && (!data.parent().parent().child('members').child(auth.uid).child('lastMoveAt').exists() || data.parent().parent().child('members').child(auth.uid).child('lastMoveAt').val() <= now - 80)",
						".validate": "newData.hasChildren(['seq', 'by', 'type', 'at']) && $seq.matches(/^[0-9]{6}$/)",
						"seq": {
							".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 9999"
						},
						"by": {
							".validate": "newData.val() === auth.uid"
						},
						"type": {
							".validate": "newData.isString() && (newData.val() === 'BUILD' || newData.val() === 'UPGRADE' || newData.val() === 'SELL' || newData.val() === 'REPAIR' || newData.val() === 'USE_ABILITY' || newData.val() === 'BUY_ITEM' || newData.val() === 'UPGRADE_FORGE' || newData.val() === 'SELECT_COMMANDER' || newData.val() === 'BRIDGE_REPAIR' || newData.val() === 'RESCUE_STRIKE' || newData.val() === 'SURRENDER' || newData.val() === 'PAUSE' || newData.val() === 'RESUME' || newData.val() === 'NEXT_ROUND' || newData.val() === 'RESTART_MATCH' || newData.val() === 'HEARTBEAT' || newData.val() === 'CHECKSUM' || newData.val() === 'CHAT')"
						},
						"at": {
							".validate": "newData.isNumber() && newData.val() <= now && newData.val() > now - 60000"
						},
						"payload": {
							".validate": "newData.hasChildren()",
							"tick": {
								".validate": "newData.isNumber() && newData.val() >= 0"
							},
							"round": {
								".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 20"
							},
							"team": {
								".validate": "newData.val() === 'west' || newData.val() === 'east'"
							},
							"playerSlot": {
								".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 6"
							},
							"buildingType": {
								".validate": "newData.isString() && newData.val().length <= 16"
							},
							"x": {
								".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 120"
							},
							"y": {
								".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 60"
							},
							"targetId": {
								".validate": "newData.isString() && newData.val().length <= 64"
							},
							"itemId": {
								".validate": "newData.isString() && newData.val().length <= 64"
							},
							"forgeType": {
								".validate": "newData.val() === 'attack' || newData.val() === 'armor' || newData.val() === 'econ'"
							},
							"commanderId": {
								".validate": "(newData.isNumber() && newData.val() >= 1 && newData.val() <= 6) || newData.val() === 'random'"
							},
							"race": {
								".validate": "newData.isString() && newData.val().length <= 32"
							},
							"shiftKey": {
								".validate": "newData.isBoolean()"
							},
							"checksum": {
								".validate": "newData.isString() && newData.val().length <= 32"
							},
							"clientTime": {
								".validate": "newData.isNumber() && newData.val() <= now && newData.val() > now - 60000"
							},
							"$other": {
								".validate": false
							}
						},
						"$other": {
							".validate": false
						}
					}
				},
				"presence": {
					".read": "auth != null && root.child('rooms').child($code).child('members').child(auth.uid).exists()",
					"$uid": {
						".write": "auth != null && $uid === auth.uid",
						".validate": "newData.hasChildren(['online'])",
						"online": {
							".validate": "newData.isBoolean()"
						},
						"lastSeen": {
							".validate": "newData.isNumber() && newData.val() <= now && newData.val() > now - 60000"
						},
						"$other": {
							".validate": false
						}
					}
				},
				"chat": {
					".read": "auth != null && root.child('rooms').child($code).child('members').child(auth.uid).exists()",
					"$msgId": {
						".write": "auth != null && !data.exists() && newData.exists() && root.child('rooms').child($code).child('members').child(auth.uid).exists() && newData.child('senderUid').val() === auth.uid && newData.parent().parent().child('members').child(auth.uid).child('lastChatAt').val() === newData.child('at').val() && (!data.parent().parent().child('members').child(auth.uid).child('lastChatAt').exists() || data.parent().parent().child('members').child(auth.uid).child('lastChatAt').val() <= now - 800)",
						".validate": "newData.hasChildren(['senderUid', 'text', 'at'])",
						"senderUid": {
							".validate": "newData.val() === auth.uid"
						},
						"senderName": {
							".validate": "newData.isString() && newData.val().length <= 48"
						},
						"text": {
							".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 200"
						},
						"at": {
							".validate": "newData.isNumber() && newData.val() <= now && newData.val() > now - 60000"
						},
						"$other": {
							".validate": false
						}
					}
				}
			}
		},
		"lobby": {
			".read": "auth != null",
			"$gameId": {
				".read": "auth != null",
				"$code": {
					".write": "auth != null && (data.exists() ? (root.child('rooms').child($code).child('info/hostUid').val() === auth.uid || !newData.exists()) : newData.child('hostUid').val() === auth.uid)",
					".validate": "newData.hasChildren(['code', 'hostUid', 'hostName', 'gameId', 'rulesVersion', 'players', 'maxPlayers', 'modeId', 'createdAt'])",
					"code": {
						".validate": "newData.isString() && newData.val() === $code"
					},
					"hostUid": {
						".validate": "newData.isString() && (data.exists() || newData.val() === auth.uid)"
					},
					"hostName": {
						".validate": "newData.isString() && newData.val().length <= 48"
					},
					"gameId": {
						".validate": "newData.isString() && newData.val().length <= 32"
					},
					"rulesVersion": {
						".validate": "newData.isNumber()"
					},
					"players": {
						".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 6"
					},
					"maxPlayers": {
						".validate": "newData.isNumber() && newData.val() >= 2 && newData.val() <= 6"
					},
					"modeId": {
						".validate": "newData.isString()"
					},
					"createdAt": {
						".validate": "newData.isNumber() && newData.val() <= now && newData.val() > now - 60000"
					},
					"$other": {
						".validate": false
					}
				}
			}
		},
		"seek": {
			"$gameId": {
				".read": "auth != null",
				"$uid": {
					".write": "auth != null && $uid === auth.uid",
					".validate": "newData.hasChildren(['uid', 'name', 'at'])",
					"uid": {
						".validate": "newData.val() === auth.uid"
					},
					"name": {
						".validate": "newData.isString() && newData.val().length <= 48"
					},
					"country": {
						".validate": "newData.isString() && newData.val().length === 2"
					},
					"avatar": {
						".validate": "newData.isString() && newData.val().length <= 32"
					},
					"at": {
						".validate": "newData.isNumber() && newData.val() <= now && newData.val() > now - 60000"
					},
					"$other": {
						".validate": false
					}
				}
			}
		},
		"users": {
			"$uid": {
				"profile": {
					".read": "auth != null",
					".write": "auth != null && $uid === auth.uid",
					".validate": "newData.hasChildren(['name', 'handle'])",
					"name": {
						".validate": "newData.isString() && newData.val().length <= 48"
					},
					"handle": {
						".validate": "newData.isString() && newData.val().matches(/^[a-z0-9_]{3,20}$/)"
					},
					"country": {
						".validate": "newData.isString() && newData.val().length === 2"
					},
					"avatar": {
						".validate": "newData.isString() && newData.val().length <= 32"
					},
					"$other": {
						".validate": false
					}
				},
				"play": {
					".read": "auth != null && $uid === auth.uid",
					".write": "auth != null && $uid === auth.uid",
					".validate": "newData.hasChildren(['score', 'games'])",
					"score": {
						".validate": "newData.isNumber() && newData.val() >= 0"
					},
					"games": {
						"$gameId": {
							"wins": {
								".validate": "newData.isNumber() && newData.val() >= 0"
							},
							"losses": {
								".validate": "newData.isNumber() && newData.val() >= 0"
							},
							"score": {
								".validate": "newData.isNumber() && newData.val() >= 0"
							},
							"$other": {
								".validate": false
							}
						}
					},
					"at": {
						".validate": "newData.isNumber() && newData.val() <= now && newData.val() > now - 60000"
					},
					"$other": {
						".validate": false
					}
				}
			}
		},
		"handles": {
			"$handle": {
				".read": "auth != null",
				".write": "auth != null && $handle.matches(/^[a-z0-9_]{3,20}$/) && (data.val() === auth.uid || !data.exists() || root.child('users').child(data.val()).child('profile/handle').val() !== $handle)",
				".validate": "newData.val() === auth.uid"
			}
		},
		"leaders": {
			".read": "auth != null",
			".indexOn": ["score"],
			"$uid": {
				".write": "auth != null && $uid === auth.uid",
				".validate": "newData.hasChildren(['name', 'handle', 'score'])",
				"name": {
					".validate": "newData.isString() && newData.val().length <= 48"
				},
				"handle": {
					".validate": "newData.isString() && newData.val().matches(/^[a-z0-9_]{3,20}$/)"
				},
				"score": {
					".validate": "newData.isNumber() && newData.val() >= 1"
				},
				"country": {
					".validate": "newData.isString() && newData.val().length === 2"
				},
				"avatar": {
					".validate": "newData.isString() && newData.val().length <= 32"
				},
				"at": {
					".validate": "newData.isNumber() && newData.val() <= now && newData.val() > now - 60000"
				},
				"$other": {
					".validate": false
				}
			}
		},
		"myRooms": {
			"$uid": {
				".read": "auth != null && $uid === auth.uid",
				"$code": {
					".write": "auth != null && $uid === auth.uid",
					".validate": "newData.isNumber() || !newData.exists()"
				}
			}
		}
	}
}
