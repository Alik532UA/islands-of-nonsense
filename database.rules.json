					},
					"name": {
						".validate": "newData.isString() && newData.val().length <= 48"
					},
					"avatar": {
						".validate": "newData.isString() && newData.val().length <= 4096"
					},
					"race": {
						".validate": "newData.isString() && newData.val().length <= 32"
					},
					"score": {
						".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 100000"
					},
					"durationSec": {
						".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 86400"
					},
					"at": {
						".validate": "newData.isNumber() && newData.val() <= now && newData.val() > now - 60000"
					},
					"$other": {
						".validate": false
					}
				}
			}
